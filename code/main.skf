// ============================================
//   skf-logger — логирование для SkyForge
//   от SkyMonder
// ============================================

// Подтягиваем пакеты-помощники
пусть dt = подтянуть "skf-datetime"
пусть файлы = подтянуть "skf-files"


// --------------------------------------------
//   УРОВНИ ЛОГИРОВАНИЯ
// --------------------------------------------

пусть УРОВНИ = {
    "DEBUG": 10,
    "INFO": 20,
    "WARNING": 30,
    "ERROR": 40,
    "CRITICAL": 50
}

пусть _уровень = "INFO"
пусть _файл = ничего
пусть _формат = "[{время}] [{уровень}] {сообщение}"
пусть _цветной = ложь


// --------------------------------------------
//   НАСТРОЙКА
// --------------------------------------------

функция установить_уровень(уровень) {
    // Устанавливает минимальный уровень для вывода.
    // Всё, что ниже — игнорируется.
    // Уровни: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
    пусть уровень_верх = уровень.в_верхний()
    
    если (УРОВНИ.содержит(уровень_верх) == ложь) {
        бросить "Неизвестный уровень: " + уровень
    }
    
    _уровень = уровень_верх
}

функция установить_файл(путь) {
    // Указывает файл для записи логов.
    // Если файл не существует — создастся автоматически.
    _файл = путь
}

функция установить_формат(формат) {
    // Меняет формат вывода.
    // Доступные плейсхолдеры: {время}, {уровень}, {сообщение}, {дата}
    _формат = формат
}

функция включить_цвета() {
    // Включает цветной вывод в консоль (только для терминала).
    _цветной = истина
}

функция выключить_цвета() {
    // Отключает цветной вывод.
    _цветной = ложь
}

функция текущий_уровень() {
    // Возвращает текущий уровень логирования.
    вернуть _уровень
}

функция текущий_файл() {
    // Возвращает путь к файлу логов (или ничего).
    вернуть _файл
}


// --------------------------------------------
//   ВНУТРЕННИЕ ПОМОЩНИКИ
// --------------------------------------------

функция _время_сейчас() {
    // Возвращает текущее время в формате "2026-09-27 14:30:00"
    пусть сейчас = dt.сейчас()
    вернуть dt.форматировать(сейчас, "%Y-%m-%d %H:%M:%S")
}

функция _дата_сейчас() {
    // Возвращает текущую дату в формате "2026-09-27"
    вернуть dt.форматировать(dt.сейчас(), "%Y-%m-%d")
}

функция _цвет_уровня(уровень) {
    // Возвращает цветной текст для уровня (если включены цвета).
    если (_цветной == ложь) {
        вернуть уровень
    }
    
    // Пробуем подтянуть skf-cli для цветов
    попробовать {
        пусть cli = подтянуть "skf-cli"
        если (уровень == "DEBUG") { вернуть cli.голубой(уровень) }
        если (уровень == "INFO") { вернуть cli.зелёный(уровень) }
        если (уровень == "WARNING") { вернуть cli.жёлтый(уровень) }
        если (уровень == "ERROR") { вернуть cli.красный(уровень) }
        если (уровень == "CRITICAL") { вернуть cli.жирный(cli.красный(уровень)) }
    } поймать (ошибка) {
        // skf-cli не установлен — возвращаем как есть
    }
    
    вернуть уровень
}

функция _записать(уровень, сообщение) {
    // Внутренняя функция: форматирует и выводит лог.
    
    // Проверяем уровень
    если (УРОВНИ[уровень] < УРОВНИ[_уровень]) {
        вернуть ничего
    }
    
    // Форматируем сообщение
    пусть текст = _формат
    текст = текст.заменить("{время}", _время_сейчас())
    текст = текст.заменить("{дата}", _дата_сейчас())
    текст = текст.заменить("{уровень}", _цвет_уровня(уровень))
    текст = текст.заменить("{сообщение}", сообщение)
    
    // Вывод в консоль
    лог(текст)
    
    // Запись в файл (без цветов)
    если (_файл != ничего) {
        пусть чистый_текст = _формат
        чистый_текст = чистый_текст.заменить("{время}", _время_сейчас())
        чистый_текст = чистый_текст.заменить("{дата}", _дата_сейчас())
        чистый_текст = чистый_текст.заменить("{уровень}", уровень)
        чистый_текст = чистый_текст.заменить("{сообщение}", сообщение)
        
        попробовать {
            файлы.дописать_файл(_файл, чистый_текст + "\n")
        } поймать (ошибка) {
            лог("⚠️ Не удалось записать лог в файл: " + ошибка)
        }
    }
}


// --------------------------------------------
//   ПУБЛИЧНЫЕ ФУНКЦИИ ЛОГИРОВАНИЯ
// --------------------------------------------

функция отладка(сообщение) {
    // Уровень DEBUG (10) — для отладки.
    _записать("DEBUG", сообщение)
}

функция информация(сообщение) {
    // Уровень INFO (20) — обычная информация.
    _записать("INFO", сообщение)
}

функция предупреждение(сообщение) {
    // Уровень WARNING (30) — что-то подозрительное.
    _записать("WARNING", сообщение)
}

функция ошибка(сообщение) {
    // Уровень ERROR (40) — ошибка, но программа продолжает работу.
    _записать("ERROR", сообщение)
}

функция критично(сообщение) {
    // Уровень CRITICAL (50) — критическая ошибка.
    _записать("CRITICAL", сообщение)
}

функция лог_уровня(уровень, сообщение) {
    // Универсальная функция: уровень = "DEBUG", "INFO" и т.д.
    _записать(уровень.в_верхний(), сообщение)
}


// --------------------------------------------
//   РОТАЦИЯ ЛОГОВ
// --------------------------------------------

функция ротация(макс_размер_мб, количество_файлов) {
    // Проверяет размер файла логов и ротирует его при превышении.
    // файл.log → файл.log.1 → файл.log.2 → ...
    // количество_файлов — сколько старых версий хранить.
    если (_файл == ничего) {
        бросить "Файл логов не установлен"
    }
    если (макс_размер_мб == ничего) {
        макс_размер_мб = 10
    }
    если (количество_файлов == ничего) {
        количество_файлов = 5
    }
    
    если (файлы.существует?(_файл) == ложь) {
        вернуть ничего
    }
    
    пусть размер_байт = файлы.размер_файла(_файл)
    пусть макс_байт = макс_размер_мб * 1024 * 1024
    
    если (размер_байт < макс_байт) {
        вернуть ничего
    }
    
    // Сдвигаем старые файлы
    пусть i = количество_файлов - 1
    пока (i >= 1) {
        пусть старый = _файл + "." + строка(i)
        пусть новый = _файл + "." + строка(i + 1)
        
        если (файлы.существует?(старый)) {
            если (файлы.существует?(новый)) {
                файлы.удалить_файл(новый)
            }
            файлы.переместить(старый, новый)
        }
        i = i - 1
    }
    
    // Переименовываем текущий файл
    файлы.переместить(_файл, _файл + ".1")
    
    информация("Лог ротирован: " + _файл)
}

функция очистить_лог() {
    // Очищает файл логов (если он есть).
    если (_файл != ничего и файлы.существует?(_файл)) {
        файлы.записать_файл(_файл, "")
    }
}


// --------------------------------------------
//   ЧТЕНИЕ ЛОГОВ
// --------------------------------------------

функция прочитать_логи(количество_строк) {
    // Читает последние строки из файла логов.
    если (_файл == ничего) {
        бросить "Файл логов не установлен"
    }
    
    если (файлы.существует?(_файл) == ложь) {
        вернуть []
    }
    
    пусть строки = файлы.прочитать_строки(_файл)
    
    если (количество_строк == ничего или количество_строк >= длина(строки)) {
        вернуть строки
    }
    
    // Берём последние N строк
    пусть результат = []
    пусть начало = длина(строки) - количество_строк
    пусть i = начало
    пока (i < длина(строки)) {
        результат.добавить(строки[i])
        i = i + 1
    }
    
    вернуть результат
}

функция найти_в_логах(подстрока) {
    // Ищет подстроку в файле логов.
    пусть строки = прочитать_логи(ничего)
    пусть результат = []
    пусть подстрока_ниж = подстрока.в_нижний()
    
    для (строка в строки) {
        если (строка.в_нижний().содержит(подстрока_ниж)) {
            результат.добавить(строка)
        }
    }
    
    вернуть результат
}

функция логи_по_уровню(уровень) {
    // Возвращает все строки с указанным уровнем.
    вернуть найти_в_логах("[" + уровень.в_верхний() + "]")
}


// --------------------------------------------
//   СБРОС НАСТРОЕК
// --------------------------------------------

функция сбросить() {
    // Сбрасывает все настройки логгера к значениям по умолчанию.
    _уровень = "INFO"
    _файл = ничего
    _формат = "[{время}] [{уровень}] {сообщение}"
    _цветной = ложь
}
